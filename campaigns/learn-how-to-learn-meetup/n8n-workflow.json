{"updatedAt":"2026-11-04T07:15:13.844Z","createdAt":"2026-11-04T07:00:42.922Z","id":"2txkI2Rtz8FTdO9c","name":"Learn-How-To-Learn-Meetup-Email-Batch50","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{},"id":"9a2f1b40-27a3-4ec3-a615-1bfa2863e001","name":"When clicking ‘Execute workflow’","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-800,100]},{"parameters":{"operation":"get","dataTableId":{"__rl":true,"value":"DnCLTOjX9Xs9Nfc6","mode":"list","cachedResultName":"Course Registrations","cachedResultUrl":"/projects/Y9vcugKFkZYSAEz5/datatables/DnCLTOjX9Xs9Nfc6"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"courseName","condition":"ilike","keyValue":"یاد بگیریم چطور یاد بگیریم"}]},"limit":1000,"orderBy":true},"id":"9a2f1b40-27a3-4ec3-a615-1bfa2863e002","name":"دریافت ثبت‌نام‌کنندگان وبینار","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[-560,100]},{"parameters":{"jsCode":"const items = $input.all();\n\n// 1. استخراج و تمیزکاری ایمیل‌ها و فیلتر موارد نامعتبر\nconst rawEmails = items\n  .map(item => item.json.email || item.json.Email || \"\")\n  .map(e => String(e).trim().toLowerCase())\n  .filter(e => e && e.includes(\"@\") && e.includes(\".\"));\n\n// 2. حذف تکراری‌ها (Deduplication)\nconst uniqueEmails = [...new Set(rawEmails)];\n\n// 3. دسته‌بندی ۵۰ تایی (Batching into 50)\nconst batchSize = 50;\nconst batches = [];\n\nfor (let i = 0; i < uniqueEmails.length; i += batchSize) {\n  const chunk = uniqueEmails.slice(i, i + batchSize);\n  batches.push({\n    json: {\n      batchIndex: Math.floor(i / batchSize) + 1,\n      totalBatches: Math.ceil(uniqueEmails.length / batchSize),\n      batchCount: chunk.length,\n      totalEmails: uniqueEmails.length,\n      // فرمت استاندارد Comma-Separated برای فیلد BCC در ایمیل\n      bccList: chunk.join(\", \"),\n      emails: chunk\n    }\n  });\n}\n\nreturn batches;"},"id":"9a2f1b40-27a3-4ec3-a615-1bfa2863e003","name":"دسته‌بندی ۵۰ تایی (Batch 50 BCC)","type":"n8n-nodes-base.code","typeVersion":2,"position":[-320,100]},{"parameters":{"fromEmail":"behradz@gmail.com","toEmail":"behradz@gmail.com","subject":"لینک حضور در دورهمی «یاد بگیریم چطور یاد بگیریم» • امروز ساعت ۱۹:۰۰","html":"<!DOCTYPE html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <title>لینک حضور در دورهمی «یاد بگیریم چطور یاد بگیریم»</title>\n    <!--[if mso]>\n    <style type=\"text/css\">\n        body, table, td, a, span, p, h1, h2, h3, strong { font-family: Tahoma, Arial, sans-serif !important; }\n    </style>\n    <![endif]-->\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap');\n        * {\n            box-sizing: border-box;\n        }\n        body {\n            margin: 0;\n            padding: 0;\n            width: 100% !important;\n            background-color: #070b12;\n            font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Arial, sans-serif;\n            -webkit-font-smoothing: antialiased;\n            -ms-text-size-adjust: 100%;\n            -webkit-text-size-adjust: 100%;\n            direction: rtl;\n        }\n        img {\n            border: 0;\n            outline: none;\n            text-decoration: none;\n            -ms-interpolation-mode: bicubic;\n        }\n        a {\n            text-decoration: none;\n        }\n        @media only screen and (max-width: 620px) {\n            .email-container {\n                width: 100% !important;\n                padding: 12px !important;\n            }\n            .content-card {\n                padding: 22px 16px !important;\n            }\n            .info-grid td {\n                display: block !important;\n                width: 100% !important;\n                margin-bottom: 8px !important;\n                padding-left: 0 !important;\n                padding-right: 0 !important;\n            }\n            .cta-button {\n                display: block !important;\n                width: 100% !important;\n                text-align: center !important;\n            }\n            .btn-table {\n                width: 100% !important;\n            }\n        }\n    </style>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #070b12; font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Arial, sans-serif; color: #cbd5e1; direction: rtl; text-align: right;\">\n\n    <!-- متن پیش‌نمایش مخفی در اینباکس -->\n    <div style=\"display: none; font-size: 1px; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;\">\n        لینک حضور در دورهمی تعاملی «یاد بگیریم چطور یاد بگیریم» • امروز ساعت ۱۹:۰۰ تا ۲۰:۰۰ در Google Meet\n    </div>\n\n    <!-- بدنه اصلی ایمیل -->\n    <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #070b12; min-height: 100vh; padding: 36px 10px;\">\n        <tr>\n            <td align=\"center\">\n\n                <!-- کارت اصلی محتوا (Luxury Dark Navy) -->\n                <table role=\"presentation\" class=\"email-container\" width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px; width: 100%; margin: 0 auto; background-color: #0d1522; border-radius: 16px; border: 1px solid #1e293b; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75);\">\n\n                    <!-- نوار متالیک طلای آنتیک بالا -->\n                    <tr>\n                        <td height=\"4\" style=\"background: linear-gradient(90deg, #573e0e, #a67c1e, #c59b27, #dfba4f, #c59b27, #a67c1e, #573e0e); font-size: 0px; line-height: 0px;\">&nbsp;</td>\n                    </tr>\n\n                    <!-- هدر و بج وضعیت -->\n                    <tr>\n                        <td style=\"padding: 32px 36px 20px 36px;\" class=\"content-card\">\n                            <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                                <tr>\n                                    <td>\n                                        <span style=\"display: inline-block; background-color: rgba(197, 155, 39, 0.12); color: #dfba4f; border: 1px solid rgba(197, 155, 39, 0.3); border-radius: 20px; padding: 5px 14px; font-size: 12.5px; font-weight: 600; letter-spacing: -0.2px;\">\n                                            ● دورهمی آنلاین امروز • ساعت ۱۹:۰۰ تا ۲۰:۰۰\n                                        </span>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <td style=\"padding-top: 18px;\">\n                                        <h1 style=\"margin: 0; color: #ffffff; font-size: 22px; font-weight: 800; line-height: 1.5; letter-spacing: -0.3px;\">\n                                            لینک حضور در دورهمی «یاد بگیریم چطور یاد بگیریم»\n                                        </h1>\n                                        <p style=\"margin: 8px 0 0 0; color: #94a3b8; font-size: 14px; font-weight: 500; line-height: 1.6;\">\n                                            گفتگوی صمیمی، دوطرفه و تبادل تجربه پیرامون چالش‌ها و روش‌های یادگیری\n                                        </p>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n\n                    <!-- خط جداکننده ظریف -->\n                    <tr>\n                        <td style=\"padding: 0 36px;\">\n                            <div style=\"height: 1px; background-color: #1a2436; width: 100%;\"></div>\n                        </td>\n                    </tr>\n\n                    <!-- متن پیام اصلی -->\n                    <tr>\n                        <td style=\"padding: 24px 36px 12px 36px;\" class=\"content-card\">\n                            \n                            <p style=\"margin: 0 0 16px 0; color: #cbd5e1; font-size: 15px; line-height: 1.85; font-weight: 400;\">\n                                سلام و درود به همه همراهان عزیز،\n                            </p>\n\n                            <p style=\"margin: 0 0 16px 0; color: #cbd5e1; font-size: 15px; line-height: 1.85; font-weight: 400;\">\n                                امروز <strong>چهارشنبه ۴ نوامبر (۱۴ آبان)</strong>، قراره ساعت <strong>۱۹:۰۰ تا ۲۰:۰۰</strong> دور هم جمع بشیم تا یک گفتگوی کاملاً خودمانی، صمیمی و دوطرفه درباره مسیر یادگیری داشته باشیم.\n                            </p>\n\n                            <p style=\"margin: 0 0 20px 0; color: #cbd5e1; font-size: 15px; line-height: 1.85; font-weight: 400;\">\n                                این جلسه به هیچ‌وجه یک کلاس خشک یا سخنرانیِ یک‌طرفه نیست. هدف اصلی اینه که فضا کاملاً تعاملی باشه، میکروفون‌ها باز بشه و همه بتونیم از تجربیات، آزمون‌وخطاها و تکنیک‌های همدیگه در بهبود یادگیری استفاده کنیم.\n                            </p>\n\n                            <!-- باکس آمادگی ذهنی قبل از ورود به جلسه -->\n                            <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #111c2e; border: 1px solid #1e293b; border-radius: 12px; margin-bottom: 24px;\">\n                                <tr>\n                                    <td style=\"padding: 20px;\">\n                                        <h3 style=\"margin: 0 0 12px 0; color: #dfba4f; font-size: 15px; font-weight: 700;\">\n                                            💡 قبل از شروع جلسه، چند دقیقه با خودتون فکر کنید:\n                                        </h3>\n                                        \n                                        <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                                            <tr>\n                                                <td style=\"padding: 6px 0; color: #cbd5e1; font-size: 13.5px; line-height: 1.8;\">\n                                                    🔹 <strong>چالش‌های یادگیری:</strong> در حال حاضر بزرگ‌ترین گیر یا مانع شما در یادگیری مباحث سخت و جدید چیه؟ (تعلل، سردرگمی بین انبوه دوره‌ها، فراموشی یا عدم استمرار؟)\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 6px 0; color: #cbd5e1; font-size: 13.5px; line-height: 1.8;\">\n                                                    🔹 <strong>تجربه‌های موفق:</strong> چه روش، تکنیک یا عادتی تا حالا براتون معجزه کرده و دوست دارین با بقیه هم به اشتراک بذارید؟\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 6px 0; color: #cbd5e1; font-size: 13.5px; line-height: 1.8;\">\n                                                    🔹 <strong>سوالات و دغدغه‌ها:</strong> چه سوال یا دغدغه‌ای گوشه ذهنتونه که دوست دارین توی جمع مطرح کنیم و با هم درباره‌ش هم‌فکری کنیم؟\n                                                </td>\n                                            </tr>\n                                        </table>\n                                    </td>\n                                </tr>\n                            </table>\n\n                            <!-- باکس مشخصات زمان‌بندی و پلتفرم -->\n                            <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #0b1320; border: 1px dashed #28374f; border-radius: 12px; margin-bottom: 26px;\">\n                                <tr>\n                                    <td style=\"padding: 16px 20px;\">\n                                        <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                                            <tr>\n                                                <td style=\"padding: 4px 0; color: #e2e8f0; font-size: 13.5px;\">\n                                                    📅 <strong>تاریخ:</strong> امروز چهارشنبه ۴ نوامبر (۱۴ آبان)\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 4px 0; color: #e2e8f0; font-size: 13.5px;\">\n                                                    ⏰ <strong>زمان:</strong> ساعت ۱۹:۰۰ الی ۲۰:۰۰ (۷ تا ۸ عصر به وقت ایران)\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 4px 0; color: #e2e8f0; font-size: 13.5px;\">\n                                                    📍 <strong>بستر جلسه:</strong> گوگل میت (Google Meet)\n                                                </td>\n                                            </tr>\n                                        </table>\n                                    </td>\n                                </tr>\n                            </table>\n\n                            <!-- دکمه CTA اول: ورود مستقیم به گوگل میت -->\n                            <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin-bottom: 16px;\">\n                                <tr>\n                                    <td align=\"center\">\n                                        <a href=\"https://meet.google.com/jge-pnoj-xmv\" target=\"_blank\" class=\"cta-button\" style=\"display: block; width: 100%; box-sizing: border-box; background: linear-gradient(135deg, #c59b27 0%, #a67c1e 60%, #856114 100%); background-color: #c59b27; color: #04060a; font-size: 16px; font-weight: 800; text-align: center; padding: 16px 24px; border-radius: 10px; text-decoration: none; box-shadow: 0 6px 20px rgba(197, 155, 39, 0.25);\">\n                                            ورود به جلسه گوگل میت &larr;\n                                        </a>\n                                        <div style=\"margin-top: 8px; font-size: 12px; color: #8b9bb4; direction: ltr; text-align: center;\">\n                                            <a href=\"https://meet.google.com/jge-pnoj-xmv\" style=\"color: #8b9bb4; text-decoration: underline;\">https://meet.google.com/jge-pnoj-xmv</a>\n                                        </div>\n                                    </td>\n                                </tr>\n                            </table>\n\n                            <!-- دکمه CTA دوم: افزودن به گوگل کلندر -->\n                            <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin-bottom: 28px;\">\n                                <tr>\n                                    <td align=\"center\">\n                                        <a href=\"https://calendar.google.com/calendar/render?action=TEMPLATE&text=%D8%AF%D9%88%D8%B1%D9%87%D9%85%DB%8C+%D8%A2%D9%86%D9%84%D8%A7%DB%8C%D9%86%3A+%DB%8C%D8%A7%D8%AF+%D8%A8%DA%AF%DB%8C%D8%B1%DB%8C%D9%85+%DA%86%D8%B7%D9%88%D8%B1+%DB%8C%D8%A7%D8%AF+%D8%A8%DA%AF%DB%8C%D8%B1%DB%8C%D9%85&dates=20261104T153000Z%2F20261104T163000Z&ctz=Asia%2FTehran&details=%D8%AF%D9%88%D8%B1%D9%87%D9%85%DB%8C+%D8%A2%D9%86%D9%84%D8%A7%DB%8C%D9%86+%D9%88+%D8%AA%D8%B9%D8%A7%D9%85%D9%84%DB%8C+%D8%A8%D8%B1%D8%A7%DB%8C+%D8%A7%D8%B4%D8%AA%D8%B1%D8%A7%DA%A9+%D8%AA%D8%AC%D8%B1%D8%A8%DB%8C%D8%A7%D8%AA%D8%8C+%D9%BE%D8%B1%D8%B3%D8%B4+%D9%88+%D9%BE%D8%A7%D8%B3%D8%AE+%D9%88+%D8%A8%D8%B1%D8%B1%D8%B3%DB%8C+%DA%86%D8%A7%D9%84%D8%B4%E2%80%8C%D9%87%D8%A7%DB%8C+%DB%8C%D8%A7%D8%AF%DA%AF%DB%8C%D8%B1%DB%8C.%0A%0A%D9%84%DB%8C%D9%86%DA%A9+%DA%AF%D9%88%DA%AF%D9%84+%D9%85%DB%8C%D8%AA%3A%0Ahttps%3A%2F%2Fmeet.google.com%2Fjge-pnoj-xmv%0A%0A%D8%A7%D8%B1%D8%AA%D8%A8%D8%A7%D8%B7+%D8%AA%D9%84%DA%AF%D8%B1%D8%A7%D9%85%3A+%40bzari&location=https%3A%2F%2Fmeet.google.com%2Fjge-pnoj-xmv\" target=\"_blank\" class=\"cta-button\" style=\"display: block; width: 100%; box-sizing: border-box; background-color: #152238; border: 1px solid #2d4268; color: #e2e8f0; font-size: 15px; font-weight: 700; text-align: center; padding: 14px 24px; border-radius: 10px; text-decoration: none; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);\">\n                                            📅 افزودن رویداد به تقویم گوگل (Google Calendar)\n                                        </a>\n                                        <div style=\"margin-top: 8px; font-size: 11.5px; color: #64748b; text-align: center;\">\n                                            با کلیک روی این دکمه، یادآور ساعت ۱۹:۰۰ همراه با لینک Meet در تقویم شما ثبت می‌شود.\n                                        </div>\n                                    </td>\n                                </tr>\n                            </table>\n\n                            <!-- کادر ارتباط و پشتیبانی -->\n                            <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #111c2e; border: 1px solid #1e293b; border-radius: 12px; margin-bottom: 12px;\">\n                                <tr>\n                                    <td style=\"padding: 16px 20px;\">\n                                        <p style=\"margin: 0; color: #94a3b8; font-size: 13px; line-height: 1.8;\">\n                                            📌 اگر در زمان ورود به جلسه یا اتصال با مشکلی مواجه شدید، می‌توانید مستقیماً در تلگرام به من پیام بدید: \n                                            <a href=\"https://t.me/bzari\" target=\"_blank\" style=\"color: #dfba4f; text-decoration: underline; font-weight: 600; direction: ltr; display: inline-block;\">@bzari</a>\n                                        </p>\n                                    </td>\n                                </tr>\n                            </table>\n\n                        </td>\n                    </tr>\n\n                    <!-- فوتر ایمیل -->\n                    <tr>\n                        <td style=\"padding: 24px 36px 32px 36px; text-align: center;\" class=\"content-card\">\n                            <p style=\"margin: 0 0 6px 0; color: #94a3b8; font-size: 13.5px; font-weight: 500;\">\n                                مشتاق دیدارتون در گفتگوی امروز هستم،\n                            </p>\n                            <p style=\"margin: 0 0 16px 0; color: #dfba4f; font-size: 14px; font-weight: 700;\">\n                                بهراد زاری\n                            </p>\n                            <p style=\"margin: 0; color: #475569; font-size: 11.5px;\">\n                                <a href=\"https://behradz.ir\" style=\"color: #64748b; text-decoration: none;\">behradz.ir</a>\n                            </p>\n                        </td>\n                    </tr>\n\n                </table>\n                <!-- پایان کارت اصلی -->\n\n            </td>\n        </tr>\n    </table>\n\n</body>\n</html>","options":{"appendAttribution":false,"bccEmail":"={{ $json.bccList }}"}},"id":"9a2f1b40-27a3-4ec3-a615-1bfa2863e004","name":"ارسال ایمیل دورهمی (Batch BCC)","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[-80,100],"credentials":{"smtp":{"id":"eQXI6HGSIYdFcYef","name":"SMTP account"}},"webhookId":"589b97d8-2559-4387-8152-dc799aa5179f"}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"دریافت ثبت‌نام‌کنندگان وبینار","type":"main","index":0}]]},"دریافت ثبت‌نام‌کنندگان وبینار":{"main":[[{"node":"دسته‌بندی ۵۰ تایی (Batch 50